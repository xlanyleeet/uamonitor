{
  "name": "uamonitor-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.19.15",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5"
  },
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
