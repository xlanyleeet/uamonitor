# Copy to .env. Use a random URL-safe password; never commit .env.
UM_DB_PASSWORD=replace-with-a-long-random-password
UM_BIND=127.0.0.1
UM_HTTP_PORT=9013
UM_POLL_SECONDS=600
UM_POLL_CONCURRENCY=16
UM_RETENTION_DAYS=30

# Private moderation channel only. Never commit the webhook or share moderation links.
UM_DISCORD_WEBHOOK_URL=
# Public HTTPS origin, e.g. https://monitor.example.org (no trailing path).
UM_PUBLIC_URL=
